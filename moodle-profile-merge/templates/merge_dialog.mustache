{{!
    @template local_profilemerge/merge_dialog

    Template for the modal dialog body that appears after OIDC login.

    Classes required for JS: none

    Data attributes required for JS:
    * data-suppress-checkbox - the suppress checkbox element

    Context variables required for this template:
    * dialogBody - The explanatory text from admin settings (HTML)
    * suppressLabel - Label for the "don't show again" checkbox

    Example context (json):
    {
        "dialogBody": "You have logged in with your new account...",
        "suppressLabel": "Don't show again after login"
    }
}}
<div class="local-profilemerge-dialog">
    <div class="mb-3">
        {{{dialogBody}}}
    </div>
    <div class="form-check mt-3">
        <input type="checkbox" class="form-check-input" id="local-profilemerge-suppress"
               data-suppress-checkbox="true">
        <label class="form-check-label" for="local-profilemerge-suppress">
            {{suppressLabel}}
        </label>
    </div>
</div>

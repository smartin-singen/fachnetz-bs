{
  "name": "bubble-navigation",
  "version": "0.10.0",
  "description": "Bubble Navigation für Fachnetz",
  "license": "MIT",
  "author": "Holger Engels",
  "repository": {
    "type": "git",
    "url": "https://github.com/smartin-singen/fachnetz-bs.git"
  },
  "homepage": "https://fachnetz-bs.zsl-bw.de/",
  "keywords": [
    "landesfachschaft",
    "fachnetz"
  ],
  "type": "module",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "scripts": {
    "start": "tsc && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"wds\"",
    "build": "tsc",
    "build:watch": "tsc -w",
    "check": "tsc --noEmit",
    "format": "prettier \"src/**/*.ts\" --write",
    "lint": "prettier \"src/**/*.ts\" --check",
    "prepublishOnly": "tsc"
  },
  "engines": {
    "npm": ">=8.5.0",
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@web/dev-server": "^1.0.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "avoid"
  }
}
